# Copy to .env.local and adjust as needed. Vite only exposes variables
# prefixed with VITE_ to the browser.

# Base URL of the FastAPI backend (see backend/api/main.py).
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to use the local mock responses in src/lib/mockAgent.js
# instead of calling the real backend — useful for frontend-only work.
VITE_USE_MOCK=false
